{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Linux runner-identify/2",
  "description": "One UTF-8 JSON object followed by LF; <=1024 bytes including LF; reject duplicate decoded keys and malformed Unicode. Integer PID lexical decimal without fraction/exponent/sign. Schema validation alone is insufficient for lexical rules. Not admission authority.",
  "oneOf": [
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/response"
    }
  ],
  "$defs": {
    "inode": {
      "type": "string",
      "pattern": "^(?:[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]{1}|1844674407370955161[0-4]|18446744073709551615)$"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "boot_id",
        "pidfs_inode",
        "pid_namespace_inode",
        "user_namespace_inode"
      ],
      "properties": {
        "kind": {
          "const": "linux-pidfs-v1"
        },
        "boot_id": {
          "type": "string",
          "pattern": "^(?!00000000-0000-0000-0000-000000000000$)[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "pidfs_inode": {
          "$ref": "#/$defs/inode"
        },
        "pid_namespace_inode": {
          "$ref": "#/$defs/inode"
        },
        "user_namespace_inode": {
          "$ref": "#/$defs/inode"
        }
      }
    },
    "child": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pid",
        "identity"
      ],
      "properties": {
        "pid": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "identity": {
          "$ref": "#/$defs/identity"
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "execution",
        "expected_instance"
      ],
      "properties": {
        "schema": {
          "const": "runner-identify-request-v2"
        },
        "execution": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$",
          "description": "Additionally at most 128 decoded UTF-8 bytes; bounded Go codec is normative."
        },
        "expected_instance": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "execution",
        "instance",
        "result",
        "reason",
        "child"
      ],
      "properties": {
        "schema": {
          "const": "runner-identify-response-v2"
        },
        "execution": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$",
          "description": "Additionally at most 128 decoded UTF-8 bytes; bounded Go codec is normative."
        },
        "instance": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{32}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "result": {
          "enum": [
            "verified",
            "unavailable",
            "conflict"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "child": {
          "oneOf": [
            {
              "$ref": "#/$defs/child"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "oneOf": [
        {
          "properties": {
            "result": {
              "const": "verified"
            },
            "reason": {
              "type": "null"
            },
            "instance": {
              "type": "string",
              "pattern": "^[0-9a-f]{32}$"
            },
            "child": {
              "$ref": "#/$defs/child"
            }
          }
        },
        {
          "properties": {
            "result": {
              "const": "conflict"
            },
            "reason": {
              "enum": [
                "execution_mismatch",
                "instance_mismatch"
              ]
            },
            "instance": {
              "type": "null"
            },
            "child": {
              "type": "null"
            }
          }
        },
        {
          "properties": {
            "result": {
              "const": "unavailable"
            },
            "reason": {
              "enum": [
                "birth_unavailable",
                "child_reaped",
                "wait_unknown",
                "runner_closed",
                "busy",
                "unsupported_platform"
              ]
            },
            "instance": {
              "type": "null"
            },
            "child": {
              "type": "null"
            }
          }
        }
      ]
    }
  }
}
